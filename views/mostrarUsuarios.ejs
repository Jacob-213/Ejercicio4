<%- include("templates/encabezado") %>
    <h1>Usuarios registrados</h1>
    <div class="contenedor">
        <table>
            <thead>
                <th>Id</th>
                <th>Nombre</th>
                <th>Celular</th>
                <th>Correo</th>
                <th>Editar / Borrar</th>
            </thead>
            <tbody>
                <% usuariosCorrectos.forEach((usuario)=>{ %>
                
                <tr>
                <td><%= usuario.idusuarios %></td>
                <td><%= usuario.nombre %></td>
                <td><%= usuario.celular %></td>
                <td><%= usuario.correo %></td>
                <td>
                    <a href="/editarUsuario/<%= usuario.idusuarios %>">Editar</a> /
                    <a href="/borrarUsuario/<%= usuario.idusuarios %>">Borrar</a>
                </td>
            </tr>
        <% }); %>
            </tbody>
        </table>
        <a href="/agregarUsuario"><button id="agregar_usuario" class="agregar_usuario" type="button">Agregar Usuario</button></a>
    </div>
    
<%- include("templates/pie") %>
